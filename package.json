{
  "name": "move-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An attributed, searchable exercise catalog with equipment availability filters.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "data": "python3 scripts/catalog.py",
    "illustrations:prepare": "python3 scripts/prepare-illustrations.py",
    "illustrations:sync": "node scripts/sync-illustrations.mjs",
    "illustrations:progress": "node scripts/illustration-progress.mjs",
    "test": "node --test tests/*.test.mjs && python3 tests/catalog_test.py",
    "build": "node scripts/build.mjs",
    "licenses": "node scripts/build-credits.mjs"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/aoml3245/move-atlas.git"
  },
  "homepage": "https://aoml3245.github.io/move-atlas/"
}
